{
  "functions": {
    "api/solve.py": {
      "includeFiles": "{data/forecast/**,engine/**}",
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "{**/*.pyi,**/tests/**,**/pulp/solverdir/cbc/{osx,win}/**,data/{b*,e*,fi*,h*,m*,o*,p*,r*,u*}/**}"
    },
    "api/forecast.py": {
      "includeFiles": "{data-deploy/**,engine/**,scripts/**}",
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "{**/*.pyi,**/tests/**,**/pulp/solverdir/cbc/{osx,win}/**,data/**}"
    }
  }
}
